{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"PRETOOLUSE_FIRED $(date -u +%FT%TZ)\" >> /tmp/hook-probe.log"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"SESSIONSTART_FIRED $(date -u +%FT%TZ)\" >> /tmp/hook-probe.log"
          }
        ]
      }
    ]
  }
}
