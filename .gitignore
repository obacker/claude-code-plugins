# OS files
.DS_Store

# Python cache
__pycache__/
*.pyc

# Claude Code local settings
.claude/settings.local.json

# ADLC runtime artifacts (generated at runtime, not part of plugin source)
plugins/*/.sdlc/
# Root-level .sdlc/ is runtime state too (agent-log.txt, context-snapshot.md,
# enforcement flags) — never plugin source.
/.sdlc/
