{
  "name": "adlc-solo",
  "version": "3.0.0",
  "description": "Lightweight solo dev workflow: spec-lite, plan-mode gate for risky changes, verification loop, and a pre-commit review pass. Optional companions: pr-review-toolkit, commit-commands.",
  "author": {
    "name": "oBacker",
    "email": "tuan@obacker.com",
    "url": "https://github.com/obacker"
  },
  "license": "MIT",
  "homepage": "https://github.com/obacker/claude-code-plugins",
  "keywords": ["sdlc", "solo", "code-review", "verification"],
  "userConfig": {
    "projectStack": {
      "title": "Project Stack",
      "description": "Primary language/framework (e.g., 'typescript/nextjs', 'go/gin', 'python/fastapi')",
      "type": "string",
      "required": false
    },
    "lspPlugin": {
      "title": "LSP Plugin",
      "description": "LSP plugin for your stack (e.g., 'typescript-lsp', 'pyright-lsp', 'gopls-lsp')",
      "type": "string",
      "required": false
    }
  }
}
