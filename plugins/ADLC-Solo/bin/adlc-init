#!/usr/bin/env bash
# ============================================================================
# adlc-init — Initialize ADLC v13 for a project
#
# Copies scaffold templates, detects project stack, generates starter
# verification.yml with detected commands. Run once per project.
#
# Usage: adlc-init [--force]
#   --force: overwrite existing files (default: skip existing)
# ============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(dirname "$SCRIPT_DIR")"
SCAFFOLD_DIR="$PLUGIN_ROOT/scaffold"
FORCE=false
VENDOR=false

# Parse args
for arg in "$@"; do
    case $arg in
        --force) FORCE=true ;;
        --vendor) VENDOR=true ;;
        --help|-h)
            echo "Usage: adlc-init [--force] [--vendor]"
            echo "Initialize ADLC v13 scaffold for the current project."
            echo ""
            echo "Options:"
            echo "  --force    Overwrite existing scaffold files"
            echo "  --vendor   Copy agents/, skills/ and hooks/ into .claude/ and wire"
            echo "             them into .claude/settings.json with relative paths."
            echo "             Required for Claude Code cloud sessions, which load"
            echo "             repo .claude/ but not user-level installed plugins."
            echo "  --help     Show this help"
            exit 0
            ;;
    esac
done

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}ADLC v13 — Project Initialization${NC}"
echo "=================================="
echo ""

# --- Detect project info ---
PROJECT_NAME=$(basename "$(pwd)")
echo -e "Project: ${GREEN}$PROJECT_NAME${NC}"

# --- Detect stack ---
STACK="unknown"
BUILD_CMD=""
LINT_CMD=""
TEST_CMD=""
DEV_CMD=""
DEPS_CHECK=""
TYPECHECK_CMD=""

if [[ -f "package.json" ]]; then
    # Node.js project
    if [[ -f "tsconfig.json" ]]; then
        STACK="TypeScript / Node.js"
        TYPECHECK_CMD="npx tsc --noEmit"
    else
        STACK="JavaScript / Node.js"
        TYPECHECK_CMD="echo 'no type checking configured'"
    fi

    # Detect framework
    if grep -q '"next"' package.json 2>/dev/null; then
        STACK="$STACK / Next.js"
        BUILD_CMD="npm run build"
        DEV_CMD="npm run dev"
    elif grep -q '"nuxt"' package.json 2>/dev/null; then
        STACK="$STACK / Nuxt"
        BUILD_CMD="npm run build"
        DEV_CMD="npm run dev"
    elif grep -q '"express"' package.json 2>/dev/null; then
        STACK="$STACK / Express"
        BUILD_CMD="npm run build"
        DEV_CMD="npm run dev"
    fi

    # Detect test runner
    if grep -q '"vitest"' package.json 2>/dev/null; then
        TEST_CMD="npx vitest run"
    elif grep -q '"jest"' package.json 2>/dev/null; then
        TEST_CMD="npx jest"
    elif grep -q '"mocha"' package.json 2>/dev/null; then
        TEST_CMD="npx mocha"
    else
        TEST_CMD="npm test"
    fi

    # Detect linter
    if grep -q '"eslint"' package.json 2>/dev/null; then
        LINT_CMD="npx eslint ."
    elif grep -q '"biome"' package.json 2>/dev/null; then
        LINT_CMD="npx biome check ."
    else
        LINT_CMD="echo 'no linter configured'"
    fi

    BUILD_CMD="${BUILD_CMD:-npm run build}"
    DEV_CMD="${DEV_CMD:-npm run dev}"
    DEPS_CHECK="npm ci --silent"

elif [[ -f "go.mod" ]]; then
    STACK="Go"
    BUILD_CMD="go build ./..."
    LINT_CMD="golangci-lint run"
    TEST_CMD="go test ./..."
    DEV_CMD="go run ."
    DEPS_CHECK="go mod download"
    TYPECHECK_CMD="go vet ./..."

    # Detect framework
    if grep -q "gin-gonic" go.mod 2>/dev/null; then
        STACK="Go / Gin"
    elif grep -q "labstack/echo" go.mod 2>/dev/null; then
        STACK="Go / Echo"
    elif grep -q "gofiber" go.mod 2>/dev/null; then
        STACK="Go / Fiber"
    fi

elif [[ -f "pyproject.toml" ]] || [[ -f "setup.py" ]] || [[ -f "requirements.txt" ]]; then
    STACK="Python"
    BUILD_CMD="echo 'no build step'"
    TEST_CMD="pytest"
    DEV_CMD="python -m uvicorn main:app --reload"
    DEPS_CHECK="pip install -r requirements.txt -q"
    TYPECHECK_CMD="mypy ."

    if [[ -f "pyproject.toml" ]]; then
        if grep -q "fastapi" pyproject.toml 2>/dev/null; then
            STACK="Python / FastAPI"
        elif grep -q "django" pyproject.toml 2>/dev/null; then
            STACK="Python / Django"
            TEST_CMD="python manage.py test"
            DEV_CMD="python manage.py runserver"
        elif grep -q "flask" pyproject.toml 2>/dev/null; then
            STACK="Python / Flask"
        fi
    fi

    # Detect linter
    if [[ -f "pyproject.toml" ]] && grep -q "ruff" pyproject.toml 2>/dev/null; then
        LINT_CMD="ruff check ."
    else
        LINT_CMD="flake8 ."
    fi

elif [[ -f "Cargo.toml" ]]; then
    STACK="Rust"
    BUILD_CMD="cargo build"
    LINT_CMD="cargo clippy -- -D warnings"
    TEST_CMD="cargo test"
    DEV_CMD="cargo run"
    DEPS_CHECK="cargo fetch"
    TYPECHECK_CMD="cargo check"
fi

echo -e "Detected stack: ${GREEN}$STACK${NC}"
echo ""

# --- Copy scaffold files ---
copy_file() {
    local src="$1"
    local dest="$2"
    local desc="$3"

    if [[ -f "$dest" ]] && [[ "$FORCE" == "false" ]]; then
        echo -e "  ${YELLOW}SKIP${NC} $desc (already exists)"
    else
        cp "$src" "$dest"
        echo -e "  ${GREEN}CREATE${NC} $desc"
    fi
}

# Create .sdlc directory
mkdir -p .sdlc

# Copy and customize scaffold files
echo "Scaffold files:"

# CLAUDE.md — substitute variables
if [[ ! -f "CLAUDE.md" ]] || [[ "$FORCE" == "true" ]]; then
    sed \
        -e "s|{{PROJECT_NAME}}|$PROJECT_NAME|g" \
        -e "s|{{STACK}}|$STACK|g" \
        -e "s|{{BUILD_CMD}}|$BUILD_CMD|g" \
        -e "s|{{LINT_CMD}}|$LINT_CMD|g" \
        -e "s|{{TEST_CMD}}|$TEST_CMD|g" \
        -e "s|{{DEV_CMD}}|$DEV_CMD|g" \
        "$SCAFFOLD_DIR/CLAUDE.md" > "CLAUDE.md"
    echo -e "  ${GREEN}CREATE${NC} CLAUDE.md"
else
    echo -e "  ${YELLOW}SKIP${NC} CLAUDE.md (already exists)"
fi

# verification.yml — substitute variables
if [[ ! -f "verification.yml" ]] || [[ "$FORCE" == "true" ]]; then
    sed \
        -e "s|{{DEPS_CHECK}}|$DEPS_CHECK|g" \
        -e "s|{{BUILD_CMD}}|$BUILD_CMD|g" \
        -e "s|{{LINT_CMD}}|$LINT_CMD|g" \
        -e "s|{{TEST_CMD}}|$TEST_CMD|g" \
        -e "s|{{TYPECHECK_CMD}}|$TYPECHECK_CMD|g" \
        "$SCAFFOLD_DIR/verification.yml" > "verification.yml"
    echo -e "  ${GREEN}CREATE${NC} verification.yml"
else
    echo -e "  ${YELLOW}SKIP${NC} verification.yml (already exists)"
fi

# .claude/settings.json — project-level hooks (coexist with plugin hooks)
mkdir -p .claude
if [[ ! -f ".claude/settings.json" ]] || [[ "$FORCE" == "true" ]]; then
    # Build post-edit compile check command based on stack
    POST_EDIT_CHECK=""
    PRE_COMPACT_CHECK=""
    if [[ "$STACK" == Go* ]]; then
        POST_EDIT_CHECK="go vet ./... 2>&1 | head -20"
        PRE_COMPACT_CHECK="go build ./... && $LINT_CMD"
    elif [[ "$STACK" == TypeScript* ]] || [[ "$STACK" == JavaScript* ]]; then
        POST_EDIT_CHECK="npx tsc --noEmit 2>&1 | head -20"
        PRE_COMPACT_CHECK="$BUILD_CMD && $LINT_CMD"
    elif [[ "$STACK" == Python* ]]; then
        POST_EDIT_CHECK="$TYPECHECK_CMD 2>&1 | head -20"
        PRE_COMPACT_CHECK="$LINT_CMD"
    elif [[ "$STACK" == Rust* ]]; then
        POST_EDIT_CHECK="cargo check 2>&1 | head -20"
        PRE_COMPACT_CHECK="cargo build && $LINT_CMD"
    else
        POST_EDIT_CHECK="echo 'no compile check configured'"
        PRE_COMPACT_CHECK="echo 'no build validation configured'"
    fi

    # Substituted with python, not sed: both commands contain a literal "|"
    # (e.g. "go vet ./... 2>&1 | head -20"), which collides with sed's
    # s|...|...| delimiter and aborts the script under set -e.
    SCAFFOLD_SETTINGS="$SCAFFOLD_DIR/settings.json" \
    POST_EDIT_CHECK="$POST_EDIT_CHECK" \
    PRE_COMPACT_CHECK="$PRE_COMPACT_CHECK" \
    python3 <<'PYSETTINGS'
import os

with open(os.environ["SCAFFOLD_SETTINGS"]) as f:
    content = f.read()

for key in ("POST_EDIT_CHECK", "PRE_COMPACT_CHECK"):
    content = content.replace("{{%s}}" % key, os.environ.get(key, ""))

with open(".claude/settings.json", "w") as f:
    f.write(content)
PYSETTINGS
    echo -e "  ${GREEN}CREATE${NC} .claude/settings.json (project-level hooks)"
else
    echo -e "  ${YELLOW}SKIP${NC} .claude/settings.json (already exists)"
fi

copy_file "$SCAFFOLD_DIR/domain-context.md" "domain-context.md" "domain-context.md"
copy_file "$SCAFFOLD_DIR/domain-terms.md" "domain-terms.md" "domain-terms.md"

echo ""

# --- Vendor mode: copy the plugin into .claude/ -----------------------------
# Claude Code cloud sessions load hooks, agents and skills from the repo's
# .claude/ directory, but do NOT reliably load user-level installed plugins
# (~/.claude/settings.json does not exist there). Vendoring is the reliable
# distribution path for cloud.
if [[ "$VENDOR" == "true" ]]; then
    echo "Vendoring plugin into .claude/:"

    mkdir -p .claude
    for COMPONENT in agents skills hooks; do
        if [[ -d "$PLUGIN_ROOT/$COMPONENT" ]]; then
            rm -rf ".claude/$COMPONENT"
            cp -R "$PLUGIN_ROOT/$COMPONENT" ".claude/$COMPONENT"
            echo -e "  ${GREEN}VENDOR${NC} .claude/$COMPONENT/"
        fi
    done

    # Drop Python bytecode caches that may have been copied along.
    find .claude -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

    # Merge vendored hook entries into .claude/settings.json.
    # ${CLAUDE_PLUGIN_ROOT} does not resolve for a vendored copy, so commands
    # are rewritten to repo-relative paths.
    if [[ -f ".claude/hooks/hooks.json" ]]; then
        python3 - <<'PYVENDOR'
import json
import os
import sys

SETTINGS = ".claude/settings.json"
VENDORED = ".claude/hooks/hooks.json"

try:
    with open(VENDORED) as f:
        vendored = json.load(f).get("hooks", {})
except Exception as exc:
    print("  WARN could not read %s: %s" % (VENDORED, exc))
    sys.exit(0)


def to_relative(command):
    """${CLAUDE_PLUGIN_ROOT} does not resolve when vendored."""
    return (command
            .replace("${CLAUDE_PLUGIN_ROOT}/hooks/", ".claude/hooks/")
            .replace("$CLAUDE_PLUGIN_ROOT/hooks/", ".claude/hooks/"))


settings = {}
if os.path.exists(SETTINGS):
    try:
        with open(SETTINGS) as f:
            settings = json.load(f)
    except Exception as exc:
        # Never clobber a file we cannot parse.
        print("  WARN %s is not valid JSON (%s) — leaving it untouched" % (SETTINGS, exc))
        sys.exit(0)
if not isinstance(settings, dict):
    print("  WARN %s is not a JSON object — leaving it untouched" % SETTINGS)
    sys.exit(0)

hooks = settings.setdefault("hooks", {})
if not isinstance(hooks, dict):
    print("  WARN %s has a non-object 'hooks' key — leaving it untouched" % SETTINGS)
    sys.exit(0)

added = 0
for event, groups in vendored.items():
    existing_groups = hooks.setdefault(event, [])
    if not isinstance(existing_groups, list):
        continue

    for group in groups:
        matcher = group.get("matcher")
        entries = [dict(h, command=to_relative(h.get("command", "")))
                   for h in group.get("hooks", [])]

        # Find an existing group with the same matcher to merge into.
        target = None
        for candidate in existing_groups:
            if isinstance(candidate, dict) and candidate.get("matcher") == matcher:
                target = candidate
                break

        if target is None:
            new_group = {"hooks": entries}
            if matcher is not None:
                new_group = {"matcher": matcher, "hooks": entries}
            existing_groups.append(new_group)
            added += len(entries)
            continue

        target_hooks = target.setdefault("hooks", [])
        present = {h.get("command") for h in target_hooks if isinstance(h, dict)}
        for entry in entries:
            if entry["command"] not in present:
                target_hooks.append(entry)
                present.add(entry["command"])
                added += 1

with open(SETTINGS, "w") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")

print("  MERGE .claude/settings.json (%d hook entr%s added, existing keys preserved)"
      % (added, "y" if added == 1 else "ies"))
PYVENDOR
    fi

    echo -e "  ${YELLOW}NOTE${NC} Vendoring is what makes ADLC work in Claude Code cloud sessions — cloud loads repo .claude/ but not user-level installed plugins."
    echo ""
fi


# --- Summary ---
echo -e "${GREEN}ADLC v13 initialized!${NC}"
echo ""
if [[ "$VENDOR" == "true" ]]; then
    echo "Vendored: .claude/{agents,skills,hooks}/ + hook entries in .claude/settings.json"
    echo "Commit .claude/ so cloud sessions pick it up."
    echo ""
fi

echo "Next steps:"
echo "  1. Edit domain-context.md — describe your business domain"
echo "  2. Edit domain-terms.md — define exact terminology"
echo "  3. Review verification.yml — adjust commands for your project"
echo "  4. Review CLAUDE.md — verify detected stack and commands"
echo "  5. Review .claude/settings.json — verify project-level hooks"
echo "  6. Run: /adlc:feature [description] to build your first feature"
echo ""
echo "Workflow commands:"
echo "  /adlc:feature [description]  build a feature"
echo "  /adlc:bugfix [description]   fix a defect"
echo "  /adlc:ship                   pre-commit verification and review gate"
echo ""
echo "Optional enforcement flags (create to activate, remove to deactivate):"
echo "  .sdlc/.enforce-migrations  new up-migrations require a down artifact"
echo "                             (configure migrations: dir/up_suffix/down_suffix"
echo "                              in verification.yml — inert without it)"
echo "  .sdlc/.bugfix-active       existing test files locked (set by /adlc:bugfix)"
echo ""
echo "Companion plugins (install if not already):"
echo "  /plugin install pr-review-toolkit@claude-plugins-official"
echo "  /plugin install commit-commands@claude-plugins-official"
echo "  /plugin install claude-md-management@claude-plugins-official"
echo "  /plugin install context7@claude-plugins-official"
echo "  /plugin install github@claude-plugins-official"
